# Instagram Graph API（Business Discovery）
# 両方が空のときは、デモ用のダミーデータ（fake モード）で動作します。
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_API_VERSION=v27.0

# 1アカウントあたり取得する最新投稿数
IG_MEDIA_LIMIT=12
# 起動時の自動取得で、前回取得からこの分数以内のアカウントはスキップする（手動取得は常に実行）
IG_MIN_FETCH_INTERVAL_MINUTES=30

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true

# ngrok（スマホから使うとき: docker compose --profile mobile up）
# authtoken とドメイン（スキームなしのホスト名）は ngrok ダッシュボードで確認する
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
